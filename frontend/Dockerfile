FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_GOOGLE_MAPS_BROWSER_KEY
ARG VITE_OTP_VERIFICATION_ENABLED
ARG VITE_GOOGLE_ADS_ID
ARG VITE_GOOGLE_ADS_BOOKING_LABEL
ARG VITE_GOOGLE_ADS_PHONE_CLICK_LABEL
ARG VITE_GOOGLE_ADS_WHATSAPP_CLICK_LABEL
ARG VITE_GA4_MEASUREMENT_ID
ARG VITE_GA4_DEBUG
ARG VITE_ANALYTICS_SITE_KEY
ARG VITE_CANONICAL_BASE_URL
ARG VITE_SITE_URL

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GOOGLE_MAPS_BROWSER_KEY=$VITE_GOOGLE_MAPS_BROWSER_KEY
ENV VITE_OTP_VERIFICATION_ENABLED=$VITE_OTP_VERIFICATION_ENABLED
ENV VITE_GOOGLE_ADS_ID=$VITE_GOOGLE_ADS_ID
ENV VITE_GOOGLE_ADS_BOOKING_LABEL=$VITE_GOOGLE_ADS_BOOKING_LABEL
ENV VITE_GOOGLE_ADS_PHONE_CLICK_LABEL=$VITE_GOOGLE_ADS_PHONE_CLICK_LABEL
ENV VITE_GOOGLE_ADS_WHATSAPP_CLICK_LABEL=$VITE_GOOGLE_ADS_WHATSAPP_CLICK_LABEL
ENV VITE_GA4_MEASUREMENT_ID=$VITE_GA4_MEASUREMENT_ID
ENV VITE_GA4_DEBUG=$VITE_GA4_DEBUG
ENV VITE_ANALYTICS_SITE_KEY=$VITE_ANALYTICS_SITE_KEY
ENV VITE_CANONICAL_BASE_URL=$VITE_CANONICAL_BASE_URL
ENV VITE_SITE_URL=$VITE_SITE_URL

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
